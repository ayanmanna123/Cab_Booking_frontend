    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.21.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
